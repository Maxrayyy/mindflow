# ===== LLM 配置 =====
# 你的 API Key（DeepSeek 在 platform.deepseek.com 获取，OpenAI 在 platform.openai.com）
OPENAI_API_KEY=your-api-key-here

# API 地址（OpenAI 原生: https://api.openai.com/v1）
# DeepSeek: https://api.deepseek.com
# 硅基流动: https://api.siliconflow.cn/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 对话模型（DeepSeek 推荐: deepseek-chat）
LLM_MODEL=gpt-4o-mini

# Embedding 模型（用于向量化，让 AI 理解文本 "意思"）
EMBEDDING_MODEL=text-embedding-3-small

# ===== Telegram Bot =====
# 在 Telegram 里找 @BotFather 发送 /newbot 就能创建一个 Bot，拿到 Token
TELEGRAM_BOT_TOKEN=your-bot-token-here

# 代理 — 国内访问 Telegram API 需要
# Clash 默认: http://127.0.0.1:7890
# V2Ray 默认: http://127.0.0.1:10809
TELEGRAM_PROXY=

# ===== 数据目录 =====
# 所有数据（数据库、向量库）存在哪里
DATA_DIR=./data
